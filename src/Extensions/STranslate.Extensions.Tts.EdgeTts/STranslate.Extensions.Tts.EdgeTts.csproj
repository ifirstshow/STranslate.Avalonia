<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- WinRT TTS 依赖 Windows，按降级矩阵属 Windows 专属能力 -->
        <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX'))">net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <DefineConstants Condition="$(TargetFramework.Contains('windows'))">$(DefineConstants);WINDOWS_TFM</DefineConstants>
        <ImplicitUsings>enable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\STranslate.Sdk\STranslate.Sdk.csproj" />
    </ItemGroup>
</Project>
