<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
    </packageSources>
    <!-- CI runner 预装的离线源（library-packs / VS Offline.config）会让 restore 解析到
         与 nuget.org 不同的包版本并静默失败（MSB4181），显式清空与本地环境对齐 -->
    <fallbackPackageFolders>
        <clear/>
    </fallbackPackageFolders>
    <localPackageSources>
        <clear/>
    </localPackageSources>
</configuration>
