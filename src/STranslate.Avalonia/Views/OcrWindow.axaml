<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STranslate.Avalonia.Views.OcrWindow"
        x:CompileBindings="False"
        Title="OCR" Width="900" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="avares://STranslate.Avalonia/Assets/app.ico">
    <Grid RowDefinitions="Auto,Auto,*,2*" Margin="12" RowSpacing="8">
        <Border Grid.Row="0" Background="#1A808080" CornerRadius="4" Padding="10,5"
                IsVisible="{Binding HasQrCode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="二维码：" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding QrCodeText}" MaxWidth="560" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Content="复制" Click="OnCopyQrClick" />
                <Button Content="打开链接" Click="OnOpenQrLinkClick" x:Name="OpenQrLinkButton" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="重新识别" Command="{Binding ReRecognizeCommand}" IsEnabled="{Binding !IsProcessing}" />
            <Button Content="导入图片" Click="OnImportFileClick" />
            <Button Content="保存图片" Click="OnSaveImageClick" />
            <Button Content="复制结果" Click="OnCopyClick" />
            <Button Content="翻译此文本" Click="OnTranslateClick" FontWeight="SemiBold" />
            <CheckBox Content="标注" IsChecked="{Binding ShowAnnotation}" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="80" Height="8" VerticalAlignment="Center"
                         IsVisible="{Binding IsProcessing}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <!-- 图片区：全宽，Ctrl+滚轮缩放 / 拖拽平移 / 双击复位（ScrollViewer 承载布局式缩放） -->
        <ScrollViewer Grid.Row="2" x:Name="PreviewScroll" ClipToBounds="True"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                      Background="#22808080"
                      PointerWheelChanged="OnPreviewWheel"
                      DoubleTapped="OnPreviewReset">
            <Panel x:Name="ZoomHost" Margin="8">
                <TextBlock Text="等待截图…（Ctrl+滚轮缩放，双击复位）" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Opacity="0.5" />
                <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Canvas x:Name="AnnotationCanvas" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Panel>
        </ScrollViewer>
        <!-- 识别文本：全宽 -->
        <TextBox Grid.Row="3" x:Name="ResultTextBox" Text="{Binding ResultText}" IsReadOnly="True"
                 TextWrapping="Wrap" FontSize="14" AcceptsReturn="True" />
    </Grid>
</Window>
