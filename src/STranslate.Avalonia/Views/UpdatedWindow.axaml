<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STranslate.Avalonia.Views.UpdatedWindow"
        Title="更新完成" Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="avares://STranslate.Avalonia/Assets/app.ico"
        FontFamily="Microsoft YaHei UI,Segoe UI">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="感谢使用 STranslate.Avalonia。查看 Release 页了解本次更新内容。" Opacity="0.8" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="查看更新内容" Click="OnOpenReleaseClick" />
            <Button Content="知道了" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
