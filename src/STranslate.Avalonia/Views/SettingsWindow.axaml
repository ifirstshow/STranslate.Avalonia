<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STranslate.Avalonia.Views.SettingsWindow"
        x:CompileBindings="False"
        Title="设置" Width="560" Height="480" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Icon="avares://STranslate.Avalonia/Assets/app.ico">
    <TabControl Margin="12" TabStripPlacement="Left">
        <TabItem Header="服务">
            <ScrollViewer Margin="8">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="默认 OCR 服务" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="OcrServiceCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnOcrServiceChanged" />
                    </Grid>
                    <TextBlock Text="翻译服务：启用的服务会在点“翻译”时并发执行；开关即改即存。" Opacity="0.6" FontSize="12" />
                    <StackPanel x:Name="ServiceCardsPanel" Spacing="8" />
                    <TextBlock x:Name="ExtensionStatusText" Text="扩展设置为即改即存，修改后立即生效。" Opacity="0.6" FontSize="12" />
                    <Separator />
                    <StackPanel Spacing="8">
                        <TextBlock Text="社区插件" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="安装插件(.spkg)…" Click="OnInstallSpkgClick" />
                            <Button Content="卸载" Click="OnUninstallSpkgClick" />
                        </StackPanel>
                        <ListBox x:Name="SpkgList" MinHeight="52" MaxHeight="120" />
                        <TextBlock Text="社区插件由独立 worker 进程加载，安装/卸载后重启程序生效。" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="通用">
            <ScrollViewer Margin="8">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="源语言" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="SourceLangCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnSourceLangChanged" />
                        <TextBlock Grid.Column="2" Text="目标语言" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3" x:Name="TargetLangCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnTargetLangChanged" />
                    </Grid>
                    <CheckBox IsChecked="{Binding CtrlCcEnabled}" Content="启用 Ctrl+C+C 剪贴板划词翻译" />
                    <CheckBox IsChecked="{Binding MouseSelectionEnabled}" Content="启用鼠标划词翻译（双击/拖选）" />
                    <CheckBox IsChecked="{Binding AutoStart}" Content="开机自动启动" />
                    <CheckBox IsChecked="{Binding ClipboardMonitorEnabled}" Content="剪贴板监听常驻翻译" />
                    <CheckBox IsChecked="{Binding MouseSelectionIconEnabled}" Content="划词后显示悬浮图标（点击翻译）" />
                    <CheckBox IsChecked="{Binding AutoTranslate}" Content="自动翻译（输入后自动执行）" />
                    <TextBlock Text="以上设置即改即存。" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="数据">
            <ScrollViewer Margin="8">
                <StackPanel Spacing="14">
                    <TextBlock Text="数据目录" FontWeight="SemiBold" />
                    <TextBlock x:Name="DataDirText" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                    <TextBlock x:Name="PortableText" Opacity="0.6" FontSize="12" />
                    <Separator />
                    <TextBlock Text="配置备份" FontWeight="SemiBold" />
                    <TextBlock Text="导出/导入 settings.json、extension-settings.json 与历史数据库。导入后需重启应用生效。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出配置" Click="OnExportConfig" />
                        <Button Content="导入配置" Click="OnImportConfig" />
                        <TextBlock x:Name="DataStatusText" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <Separator />
                    <TextBlock Text="WebDav 云备份" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="服务地址" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="WebDavAddress" PlaceholderText="https://dav.jianguoyun.com/dav/" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="账号" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="WebDavUser" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="密码/应用密码" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="WebDavPass" PasswordChar="•" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="上传备份" Click="OnWebDavUpload" />
                        <Button Content="恢复备份" Click="OnWebDavRestore" />
                        <TextBlock x:Name="WebDavStatusText" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <TextBlock Text="云备份以 ST.translate.zip 命名存储于服务地址目录；恢复后需重启应用生效。" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="热键">
            <ScrollViewer Margin="8">
                <StackPanel x:Name="HotkeysPanel" Spacing="10">
                    <TextBlock Text="格式：修饰键 Ctrl/Alt/Shift/Win + 主键，如 Alt+G、Ctrl+Shift+X。支持 A-Z、0-9、F1-F24。" Opacity="0.6" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="开关主窗口" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkOpenWindow" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="输入翻译" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkInputTranslate" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="划词翻译" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkCrosswordTranslate" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="截图翻译" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkScreenshotTranslate" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="静默 OCR" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkSilentOcr" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="图片翻译" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkImageTranslate" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="静默 TTS" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="180" x:Name="HkSilentTts" IsReadOnly="True" GotFocus="OnHotkeyGotFocus" KeyDown="OnHotkeyKeyDown" />
                    </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="增量翻译键" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Width="180" x:Name="IncKeyBox" />
                        </Grid>
                        <TextBlock Text="增量翻译：按住该键（如 F9）连续划选多段文字会累积到输入框，松开后一起翻译。留空关闭。需按保存并应用热键。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="保存并应用热键" Click="OnSaveHotkeys" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="网络">
            <ScrollViewer Margin="8">
                <StackPanel Spacing="14" x:Name="NetworkPanel">
                    <CheckBox x:Name="ProxyEnabledCheck" Content="启用代理" />
                    <StackPanel x:Name="ProxyCustomPanel" Spacing="10" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="类型" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ProxyTypeCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="自定义" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="地址" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="ProxyAddress" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="端口" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="ProxyPort" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="测试连接" Click="OnTestProxyClick" />
                            <TextBlock x:Name="ProxyStatusText" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Text="系统代理类型时跟随系统（WinHTTP）设置；自定义支持 HTTP 代理。修改后点击测试即生效。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="关于">
            <ScrollViewer Margin="8">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="avares://STranslate.Avalonia/Assets/app.ico" Width="40" Height="40" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STranslate.Avalonia" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="STranslate 的 Avalonia 跨平台重构版" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <Separator />
                    <TextBlock Text="更新" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding !IsCheckingUpdate}" />
                        <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <Separator />
                    <TextBlock Text="致谢" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="基于 zggsong/STranslate 重构，感谢原作者与社区贡献。" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="打开仓库" Click="OnOpenRepoClick" FontSize="12" Padding="6,2" />
                    </StackPanel>
                    <TextBlock Text="本版插件与配置与 WPF 版不通用；文档见仓库 README。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
