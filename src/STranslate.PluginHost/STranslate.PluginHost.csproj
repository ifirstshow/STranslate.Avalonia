<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <!-- JIT 进程：社区插件动态加载专用（ADR-0004），不参与 AOT -->
    </PropertyGroup>

    <PropertyGroup>
        <!-- 默认 .artifacts/bin 布局；宿主探测 BaseDirectory 与 .artifacts/bin 两处 -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\STranslate.Worker.Ipc\STranslate.Worker.Ipc.csproj" />
        <ProjectReference Include="..\STranslate.Sdk\STranslate.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- 复用宿主的 IHttpService 实现（纯 HttpClient，无 UI 依赖） -->
        <Compile Include="..\STranslate.Avalonia\Services\HttpService.cs" Link="HttpService.cs" />
    </ItemGroup>

</Project>
